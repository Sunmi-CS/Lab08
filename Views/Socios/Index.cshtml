@model IEnumerable<Biblioteca.Web.Models.Socio>

@{
    ViewData["Title"] = "Socios";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1 class="page-title mb-1">Socios</h1>
        <p class="text-muted mb-0">
            Personas registradas en la biblioteca
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-dark">
        + Nuevo socio
    </a>

</div>

<div class="card shadow-sm">

    <div class="table-responsive">

        <table class="table table-hover">

            <thead>
                <tr>
                    <th>DNI</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var socio in Model)
                {
                    <tr>
                        <td>@socio.DNI</td>
                        <td>@socio.Nombre</td>
                        <td>@socio.Email</td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>