@model IEnumerable<Biblioteca.Web.Models.Libro>

@{
    ViewData["Title"] = "Libros";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="page-title mb-1">Libros</h1>
        <p class="text-muted mb-0">
            Administración del catálogo bibliográfico
        </p>
    </div>

    <a asp-action="Create" class="btn btn-dark">
        + Nuevo libro
    </a>
</div>

<div class="card shadow-sm">

    <div class="card-header p-3">

        <form asp-action="Index" method="get" class="d-flex gap-2">

            <input type="text"
                   name="buscar"
                   value="@ViewData["Buscar"]"
                   class="form-control search-box"
                   placeholder="Buscar por título o autor..." />

            <button type="submit" class="btn btn-dark">
                Buscar
            </button>

            <a asp-action="Index" class="btn btn-outline-secondary">
                Limpiar
            </a>

        </form>

    </div>

    <div class="table-responsive">

        <table class="table table-hover">

            <thead>
                <tr>
                    <th>Título</th>
                    <th>ISBN</th>
                    <th>Autor</th>
                    <th>Ejemplares</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            No se encontraron libros.
                        </td>
                    </tr>
                }
                else
                {
                    foreach (var libro in Model)
                    {
                        <partial name="_LibroFila" model="libro" />
                    }
                }

            </tbody>

        </table>

    </div>
</div>