@model Biblioteca.Web.Models.Libro

@{
    ViewData["Title"] = "Editar libro";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card shadow-sm">

            <div class="card-header p-4">
                <h2 class="mb-1">Editar libro</h2>
                <p class="text-muted mb-0">
                    Actualiza la información del libro.
                </p>
            </div>

            <div class="card-body p-4">

                <form asp-action="Edit" method="post">

                    <input type="hidden" asp-for="LibroId" />

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>

                    <div class="mb-3">
                        <label asp-for="Titulo" class="form-label">
                            Título
                        </label>

                        <input asp-for="Titulo"
                               class="form-control" />

                        <span asp-validation-for="Titulo"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ISBN" class="form-label">
                            ISBN
                        </label>

                        <input asp-for="ISBN"
                               class="form-control" />

                        <span asp-validation-for="ISBN"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AutorId" class="form-label">
                            Autor
                        </label>

                        <select asp-for="AutorId"
                                asp-items="@ViewBag.Autores"
                                class="form-select">
                        </select>

                        <span asp-validation-for="AutorId"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Ejemplares" class="form-label">
                            Ejemplares
                        </label>

                        <input asp-for="Ejemplares"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="Ejemplares"
                              class="text-danger">
                        </span>
                    </div>

                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-dark">
                            Guardar cambios
                        </button>

                        <a asp-action="Index"
                           class="btn btn-outline-secondary">
                            Cancelar
                        </a>

                    </div>

                </form>

            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}