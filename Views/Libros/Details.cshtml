@model Biblioteca.Web.Models.Libro

@{
    ViewData["Title"] = "Detalle del libro";
}

<div class="row justify-content-center">

    <div class="col-lg-7">

        <div class="card shadow-sm">

            <div class="card-body p-4">

                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Libro</p>
                        <h2 class="page-title">
                            @Model.Titulo
                        </h2>
                    </div>

                    <span class="badge bg-dark align-self-start">
                        Activo
                    </span>
                </div>

                <hr />

                <dl class="row mb-4">

                    <dt class="col-sm-4">ISBN</dt>
                    <dd class="col-sm-8">@Model.ISBN</dd>

                    <dt class="col-sm-4">Autor</dt>
                    <dd class="col-sm-8">@Model.NombreAutor</dd>

                    <dt class="col-sm-4">Ejemplares</dt>
                    <dd class="col-sm-8">@Model.Ejemplares</dd>

                </dl>

                <div class="d-flex gap-2">

                    <a asp-action="Edit"
                       asp-route-id="@Model.LibroId"
                       class="btn btn-dark">
                        Editar
                    </a>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Volver
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>