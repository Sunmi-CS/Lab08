@model Biblioteca.Web.Models.Libro

<tr>
    <td>
        <strong>@Model.Titulo</strong>
    </td>

    <td>
        @Model.ISBN
    </td>

    <td>
        @Model.NombreAutor
    </td>

    <td>
        @Model.Ejemplares
    </td>

    <td class="text-end">
        <a asp-action="Details"
           asp-route-id="@Model.LibroId"
           class="btn btn-sm btn-outline-secondary">
            Ver
        </a>

        <a asp-action="Edit"
           asp-route-id="@Model.LibroId"
           class="btn btn-sm btn-outline-dark">
            Editar
        </a>

        <a asp-action="Delete"
           asp-route-id="@Model.LibroId"
           class="btn btn-sm btn-outline-danger">
            Eliminar
        </a>
    </td>
</tr>